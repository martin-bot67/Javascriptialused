import java.util.Scanner;

public class Temperatuur {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Sisesta temperatuur (°C): ");
        double temperatuur = scanner.nextDouble();

        if (temperatuur > 25) {
            System.out.println("Väga kuum ilm!");
        } else if (temperatuur >= 15 && temperatuur <= 25) {
            System.out.println("Mõnus temperatuur");
        } else {
            System.out.println("Jahe ilm");
        }

        scanner.close();
    }
}